# Generated Solution — settings. Copy to deploy/.env. Do not commit .env.
# The Solution works on its own with these settings. It needs no Specificity service.

# --- Database (compose sets DATABASE_URL for the app; set it by hand to run outside compose) ---
# Use letters and digits only. Compose puts the password into DATABASE_URL, and @ / : % break that URL.
# SOLUTION_DB_PASSWORD=
# DATABASE_URL=postgresql://solution:<password>@localhost:5432/solution

# --- Model for the agents (src/solution/llm_config.py reads these) ---
# Provider: gemini (default), vertex, openai, anthropic, openrouter, azure, litellm-proxy
SOLUTION_LLM_PROVIDER=gemini
# The model name of that provider. For Gemini you may leave it empty. Then the Solution runs the model that the Precord declares.
# For any other provider you must set it. OpenRouter names a model as <vendor>/<model>.
# SOLUTION_LLM_MODEL=
# Set true to run gemini-3.8-flash in place of an older Gemini model that the Precord declares.
# Google limits some older models to accounts that already used them. The Solution never swaps unless you set this.
# SOLUTION_LLM_USE_PINNED_DEFAULT=true
# The key of the provider. The native name also works: GOOGLE_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY, AZURE_API_KEY, LITELLM_PROXY_API_KEY.
# SOLUTION_LLM_API_KEY=
GOOGLE_API_KEY=
# An address other than the default: a private endpoint, or your own proxy.
# SOLUTION_LLM_API_BASE=

# Vertex AI (SOLUTION_LLM_PROVIDER=vertex) signs in with Application Default Credentials.
# GOOGLE_CLOUD_PROJECT=
# Required. The Solution has no default region. Use the region that your data residency answer allows
# (model_region in src/solution/model_residency.json).
# GOOGLE_CLOUD_LOCATION=

# Azure OpenAI (SOLUTION_LLM_PROVIDER=azure). SOLUTION_LLM_MODEL is the deployment name.
# AZURE_API_BASE=
# AZURE_API_VERSION=

# Your own LiteLLM proxy (SOLUTION_LLM_PROVIDER=litellm-proxy)
# LITELLM_PROXY_API_BASE=http://localhost:4000

# --- Playground live ADK invoke (optional) ---
# PLAYGROUND_INVOKE_ADK=true
# SOLUTION_PREVIEW=true
